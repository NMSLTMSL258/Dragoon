@echo off
setlocal DisableDelayedExpansion
set "DRAGOON_MERGE_ROOT=%~dp0"
echo Joining Dragoon files. Please wait...
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop';function Get-DragoonHash([string]$mergeHashPath){$mergeHashInput=[System.IO.File]::OpenRead($mergeHashPath);$mergeHashAlgorithm=[System.Security.Cryptography.SHA256]::Create();try{[System.BitConverter]::ToString($mergeHashAlgorithm.ComputeHash($mergeHashInput)).Replace('-','').ToLowerInvariant()}finally{$mergeHashAlgorithm.Dispose();$mergeHashInput.Dispose()}};$joinRoot=$env:DRAGOON_MERGE_ROOT;$outPath=Join-Path $joinRoot 'Dragoon_Beta_20261116_Full.zip';$expected='b8f024d4ab17c99b625ad79f87e97cd55fa49cb6082cd0ba3a2435c6f7f7969e';if(Test-Path -LiteralPath $outPath){if((Get-DragoonHash $outPath) -eq $expected){Write-Host 'OK - complete ZIP already exists.';exit 0};throw 'A different ZIP already exists. Move it aside first.'};$partPaths=@((Join-Path $joinRoot 'Dragoon_Beta_20261116_Full.zip.001'),(Join-Path $joinRoot 'Dragoon_Beta_20261116_Full.zip.002'));foreach($partPath in $partPaths){if(!(Test-Path -LiteralPath $partPath)){throw ('Missing: '+$partPath)}};$joinPath=$outPath+'.joining';$outStream=[System.IO.File]::Open($joinPath,[System.IO.FileMode]::CreateNew,[System.IO.FileAccess]::Write,[System.IO.FileShare]::None);try{foreach($partPath in $partPaths){$inStream=[System.IO.File]::OpenRead($partPath);try{$inStream.CopyTo($outStream)}finally{$inStream.Dispose()}}}finally{$outStream.Dispose()};if((Get-DragoonHash $joinPath) -ne $expected){throw 'Checksum mismatch. Do not install this file.'};[System.IO.File]::Move($joinPath,$outPath);Write-Host 'OK - ZIP merged and SHA-256 verified. Extract the ZIP to install.'"
set "DRAGOON_MERGE_EXIT=%ERRORLEVEL%"
if not "%~1"=="--verify" pause
exit /b %DRAGOON_MERGE_EXIT%
